# .env.example

# PostgreSQL Database URL (optional for local runs)
# Format: postgresql://user:password@host:port/database?sslmode=require
# If you do not provide DATABASE_URL, the app will fall back to a local
# SQLite file (dev_database.db) unless you set ALLOW_SQLITE_FALLBACK=false.
DATABASE_URL=

# Allow using the local SQLite fallback when DATABASE_URL is empty
# Set to 'false' to require DATABASE_URL in production
ALLOW_SQLITE_FALLBACK=true

# Application settings
ENVIRONMENT=development
DEBUG=False

# App server settings
# Default port used when running `python main.py` (used as fallback if PORT is not set)
PORT=8000
HOST=0.0.0.0

# Usage limits (predictions per period)
DRAWING_LIMIT=10
VOICE_LIMIT=10
LIMIT_RESET_HOURS=3